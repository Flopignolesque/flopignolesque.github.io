---
import { t, path, switchLang, otherLang, type Lang } from '../i18n';
import { site } from '../data/site';
import Banner from './Banner.astro';

interface Props {
  lang: Lang;
  /** Chemin sans la langue, ex : "/projets/" */
  route: string;
}
const { lang, route } = Astro.props;
const ui = t(lang);
const other = otherLang(lang);
const otherHref = switchLang(path(lang, route), other);

const links = [
  { href: '/projets/', label: ui.nav.projects },
  { href: '/parcours/', label: ui.nav.journey },
  { href: '/competences/', label: ui.nav.skills },
  { href: '/passions/', label: ui.nav.passions },
  { href: '/contact/', label: ui.nav.contact },
];
const isActive = (href: string) => route.startsWith(href);
---

<header class="vt-header sticky top-0 z-50">
  <Banner lang={lang} />
  <div class="border-b border-line/70 bg-bg/80 backdrop-blur-md">
    <nav class="container-site flex h-16 items-center justify-between gap-6" aria-label={ui.nav.mainLabel}>
      <a
        href={path(lang, '/')}
        class="glitch-self font-mono text-base font-medium tracking-tight"
      >
        <span class="text-accent" aria-hidden="true">&gt;</span>FTW<span class="blink text-accent" aria-hidden="true"
          >_</span
        ><span class="sr-only">, {ui.nav.home}</span>
      </a>

      <!-- Desktop -->
      <ul class="hidden items-center gap-7 lg:flex">
        {
          links.map((link) => (
            <li>
              <a
                href={path(lang, link.href)}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class:list={[
                  'relative py-2 text-sm transition-colors hover:text-fg',
                  isActive(link.href) ? 'text-fg' : 'text-muted',
                ]}
              >
                {isActive(link.href) && (
                  <span class="absolute -left-3 font-mono text-accent" aria-hidden="true">
                    ›
                  </span>
                )}
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-2">
        <a
          href={site.cv[lang]}
          download
          class="hidden h-9 items-center rounded-md border border-line px-3 font-mono text-xs transition-colors hover:border-accent hover:text-accent sm:inline-flex"
        >
          {ui.nav.cv} <span aria-hidden="true" class="ml-1.5">↓</span>
        </a>
        <a
          href={otherHref}
          hreflang={other}
          lang={other}
          class="inline-flex h-11 min-w-11 items-center justify-center rounded-md font-mono text-xs text-muted transition-colors hover:text-accent"
        >
          <span class="text-fg" aria-hidden="true">{lang.toUpperCase()}</span><span class="mx-1" aria-hidden="true"
            >/</span
          >{ui.nav.otherLang}<span class="sr-only"> ({ui.nav.otherLangName}, {ui.nav.langLabel.toLowerCase()})</span>
        </a>

        <!-- Bouton menu mobile -->
        <button
          type="button"
          class="inline-flex h-11 w-11 items-center justify-center rounded-md lg:hidden"
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-menu-toggle
          data-label-open={ui.nav.menu}
          data-label-close={ui.nav.close}
        >
          <span class="sr-only" data-menu-label>{ui.nav.menu}</span>
          <span class="burger flex w-5 flex-col gap-1.5" aria-hidden="true">
            <span class="block h-px w-full bg-fg"></span>
            <span class="block h-px w-full bg-fg"></span>
          </span>
        </button>
      </div>
    </nav>
  </div>

  <!-- Menu plein écran (mobile) -->
  <div
    id="mobile-menu"
    class="mobile-menu bg-grid fixed inset-x-0 top-24 bottom-0 z-40 bg-bg lg:hidden"
    data-menu
  >
    <nav class="container-site flex h-full flex-col justify-between py-10" aria-label={ui.nav.menu}>
      <ul class="flex flex-col gap-1">
        {
          links.map((link, i) => (
            <li class="mobile-link">
              <a
                href={path(lang, link.href)}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class="flex items-baseline gap-4 py-2 text-4xl font-medium tracking-tight sm:text-5xl"
              >
                <span class="font-mono text-xs text-accent">0{i + 1}</span>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mobile-link flex items-center gap-3">
        <a href={site.cv[lang]} download class="btn btn-primary">
          {ui.hero.ctaCv}
        </a>
      </div>
    </nav>
  </div>
</header>
