---
import type { GetStaticPaths } from 'astro';
import { getOrdered } from '../../lib/collections';
import Base from '../../layouts/Base.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import Txt from '../../components/Txt.astro';
import { t, pick, langPaths, type Lang } from '../../i18n';

export const getStaticPaths = (() => langPaths()) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
const ui = t(lang);
const passions = await getOrdered('passions');

// Hauteurs fixes des barres de l'égaliseur (widget musique, statique)
// (classes écrites en entier pour que Tailwind les détecte)
const bars = ['h-[40%]', 'h-[70%]', 'h-[55%]', 'h-[90%]', 'h-[65%]', 'h-[80%]', 'h-[45%]', 'h-[60%]', 'h-[95%]', 'h-[50%]', 'h-[75%]', 'h-[35%]', 'h-[85%]', 'h-[55%]', 'h-[70%]', 'h-[40%]'];
---

<Base lang={lang} route="/passions/" title={ui.passions.title} description={ui.passions.intro}>
  <section class="container-site pt-16 md:pt-24">
    <SectionTitle as="h1" label="cat ~/.hobbies" title={ui.passions.title} />
    <p class="max-w-2xl text-lg text-muted md:text-xl">{ui.passions.intro}</p>

    <div class="mt-16 grid gap-4 md:grid-cols-2" data-reveal-group>
      {
        passions.map((p) => (
          <article
            class:list={[
              'flex flex-col overflow-hidden rounded-lg bg-surface',
              p.data.large && 'md:col-span-2 md:grid md:grid-cols-[1.1fr_1fr]',
            ]}
            aria-labelledby={`passion-${p.id}`}
          >
            <!-- Visuel -->
            <div
              class:list={[
                'bg-grid relative flex min-h-56 items-center justify-center overflow-hidden bg-surface-2/60 p-6 font-mono text-sm',
                p.data.large && 'md:order-2 md:min-h-full',
              ]}
              aria-hidden="true"
            >
              {p.data.visual === 'privacy' && (
                <div class="w-full max-w-sm space-y-2">
                  <p class="text-muted">$ audit --self</p>
                  {p.data.chips.map((chip) => (
                    <p class="flex items-center justify-between rounded bg-bg/70 px-3 py-2">
                      <span>{chip}</span>
                      <span class="text-accent">✓</span>
                    </p>
                  ))}
                  <p class="pt-1 text-accent">bitwarden: 258 entries migrated</p>
                </div>
              )}

              {p.data.visual === 'setup' && (
                <div class="w-full max-w-sm rounded-md bg-bg/80 p-4">
                  <p class="text-muted">
                    <span class="text-accent">$</span> cat setup.txt
                  </p>
                  {p.data.chips.map((chip) => {
                    const [key, value] = chip.split('=');
                    return (
                      <p class="mt-1.5 flex gap-3">
                        <span class="w-14 shrink-0 text-muted">{key}</span>
                        <span>{value}</span>
                      </p>
                    );
                  })}
                </div>
              )}

              {p.data.visual === 'car' && (
                <div class="flex w-full max-w-sm flex-wrap items-center justify-center gap-y-3 text-xs">
                  {['BATT 12V', 'FUSE', 'AMP', 'SUB'].map((part, i) => (
                    <>
                      {i > 0 && <span class="h-px w-5 bg-accent sm:w-7" />}
                      <span class:list={['rounded px-2.5 py-1.5', part === 'FUSE' ? 'bg-accent text-bg' : 'bg-bg/80']}>
                        {part}
                      </span>
                    </>
                  ))}
                  <p class="mt-3 w-full text-center text-muted">Pioneer · DS4</p>
                </div>
              )}

              {p.data.visual === 'music' && (
                <div class="w-full max-w-xs rounded-md bg-bg/80 p-4">
                  <p class="text-[0.7rem] tracking-widest text-accent uppercase">● {ui.passions.nowPlaying}</p>
                  <p class="mt-3 truncate text-fg">
                    <Txt text={ui.passions.nowPlayingTrack} />
                  </p>
                  <p class="truncate text-xs text-muted">{ui.passions.nowPlayingArtist}</p>
                  <div class="mt-4 flex h-10 items-end gap-1">
                    {bars.map((h) => (
                      <span class:list={['w-full rounded-sm bg-accent/70', h]} />
                    ))}
                  </div>
                  <div class="mt-3 flex items-center gap-2 text-[0.65rem] text-muted">
                    <span>1:24</span>
                    <span class="h-px flex-1 bg-line">
                      <span class="block h-px w-2/5 bg-accent" />
                    </span>
                    <span>3:12</span>
                  </div>
                </div>
              )}

              {p.data.visual === 'sport' && (
                <div class="flex items-center gap-1 text-accent">
                  <span class="h-12 w-3 rounded-sm bg-accent" />
                  <span class="h-16 w-4 rounded-sm bg-accent" />
                  <span class="h-1.5 w-28 bg-fg/80 sm:w-40" />
                  <span class="h-16 w-4 rounded-sm bg-accent" />
                  <span class="h-12 w-3 rounded-sm bg-accent" />
                </div>
              )}
            </div>

            <!-- Texte -->
            <div class="flex flex-1 flex-col p-6 md:p-8">
              <h2 id={`passion-${p.id}`} class="text-2xl font-semibold tracking-tight md:text-3xl">
                {pick(lang, p.data.title)}
              </h2>
              <p class="mt-4 leading-relaxed text-muted">{pick(lang, p.data.text)}</p>
              <p class="mt-auto pt-6 font-mono text-sm">
                <span class="text-accent">→ {ui.passions.takeaway} :</span> {pick(lang, p.data.takeaway)}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Base>
