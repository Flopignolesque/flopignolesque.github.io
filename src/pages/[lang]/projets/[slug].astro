---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Txt from '../../../components/Txt.astro';
import { t, path, isTodo, type Lang } from '../../../i18n';
import { getProjects, projectLang, projectSlug, type Project } from '../../../lib/content';

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { lang: projectLang(project), slug: projectSlug(project) },
    props: { project },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
}

const { project } = Astro.props;
const lang = Astro.params.lang as Lang;
const ui = t(lang);
const slug = projectSlug(project);
const { title, tagline, tags, kind, year, links, audit } = project.data;
const { Content } = await render(project);

const all = await getProjects(lang);
const position = all.findIndex((p) => projectSlug(p) === slug);
const next = all[(position + 1) % all.length];

const linkList = [
  { label: ui.projects.demo, value: links.demo },
  { label: ui.projects.github, value: links.github },
].filter((l) => l.value);

const showAudit = audit?.visible === true;
const sevColor = { critique: 'text-[#ff6b7a]', haute: 'text-[#ffa25c]', moyenne: 'text-[#ffcf5c]', faible: 'text-muted' };
---

<Base lang={lang} route={`/projets/${slug}/`} title={title} description={tagline}>
  <article class="container-site pt-12 md:pt-20">
    <a href={path(lang, '/projets/')} class="inline-flex min-h-11 items-center font-mono text-xs text-muted hover:text-accent">
      ← {ui.projects.back}
    </a>

    <header class="mt-8 grid gap-10 border-b border-line pb-12 lg:grid-cols-[1fr_20rem] lg:items-end">
      <div>
        <p class="label">
          <span class="text-accent">//</span>{' '}{kind} · {year}
        </p>
        <h1 class="mt-4 text-5xl font-semibold tracking-[-0.04em] text-balance sm:text-6xl md:text-7xl" data-scramble>
          {title}
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-muted md:text-xl">{tagline}</p>
      </div>

      <dl class="space-y-5 font-mono text-sm">
        <div>
          <dt class="label mb-2">Stack</dt>
          <dd class="flex flex-wrap gap-1.5">{tags.map((tag) => <span class="tag">{tag}</span>)}</dd>
        </div>
        {
          linkList.length > 0 && (
            <div>
              <dt class="label mb-2">{ui.projects.links}</dt>
              <dd class="space-y-1">
                {linkList.map((l) =>
                  isTodo(l.value) ? (
                    <p>
                      {l.label} : <Txt text={l.value!} />
                    </p>
                  ) : (
                    <p>
                      <a
                        href={l.value}
                        class="link-accent inline-flex min-h-11 items-center"
                        rel="noopener noreferrer"
                        target="_blank"
                      >
                        {l.label} ↗
                      </a>
                    </p>
                  ),
                )}
              </dd>
            </div>
          )
        }
      </dl>
    </header>

    <div class="prose-site mt-4">
      <Content />
    </div>

    {
      showAudit && audit && (
        <section class="mt-20 rounded-lg bg-surface p-6 md:p-10" aria-labelledby="audit-title" data-reveal>
          <p class="label">
            <span class="text-accent">//</span> security audit
          </p>
          <h2 id="audit-title" class="mt-3 text-3xl font-semibold tracking-tight md:text-4xl" data-scramble-view>
            {ui.projects.audit.title}
          </h2>
          {audit.intro && <p class="mt-4 max-w-2xl text-muted">{audit.intro}</p>}
          <ul class="mt-8 divide-y divide-line">
            {audit.findings.map((f) => (
              <li class="grid gap-2 py-5 md:grid-cols-[9rem_1fr_7rem] md:gap-6">
                <span class={`font-mono text-xs uppercase ${sevColor[f.severity]}`}>
                  {ui.projects.audit.sev[f.severity]}
                </span>
                <span>
                  <span class="block font-medium">{f.title}</span>
                  <span class="mt-1 block text-sm text-muted">{f.description}</span>
                </span>
                <span class={`font-mono text-xs ${f.fixed ? 'text-accent' : 'text-muted'}`}>
                  {f.fixed ? `✓ ${ui.projects.audit.fixed}` : `… ${ui.projects.audit.open}`}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      next && next !== project && (
        <a
          href={path(lang, `/projets/${projectSlug(next)}/`)}
          class="glitch group mt-24 flex flex-col gap-2 border-t border-line pt-10"
        >
          <span class="label">{ui.projects.next} →</span>
          <span class="glitch-target text-3xl font-semibold tracking-tight transition-colors group-hover:text-accent md:text-5xl">
            {next.data.title}
          </span>
        </a>
      )
    }
  </article>
</Base>
