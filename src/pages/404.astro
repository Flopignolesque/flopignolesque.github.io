---
/**
 * Page 404 (GitHub Pages la sert pour toute URL inconnue).
 * Bilingue sur une seule page : on ne connaît pas la langue du visiteur.
 */
import Base from '../layouts/Base.astro';

const suggestions = [
  { cmd: 'cd /fr/', href: '/fr/', desc: 'accueil' },
  { cmd: 'cd /en/', href: '/en/', desc: 'home (english)' },
  { cmd: 'ls projects', href: '/fr/projets/', desc: 'projets' },
  { cmd: './contact.sh', href: '/fr/contact/', desc: 'contact' },
];
---

<Base lang="fr" route="/404/" title="404" noindex>
  <section class="container-site flex min-h-[70svh] flex-col justify-center py-20">
    <p class="font-mono text-sm text-accent" data-scramble>&gt; 404: route not found</p>
    <h1 class="mt-6 text-5xl font-semibold tracking-[-0.04em] sm:text-7xl" data-scramble>Page introuvable</h1>
    <p class="mt-4 text-lg text-muted">Cette page n'existe pas (ou plus). <span lang="en">This page doesn't exist.</span></p>

    <div class="mt-12 max-w-xl overflow-hidden rounded-lg border border-line bg-surface font-mono text-sm">
      <div class="flex items-center gap-1.5 border-b border-line px-4 py-2.5" aria-hidden="true">
        <span class="h-2.5 w-2.5 rounded-full bg-surface-2"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-surface-2"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-[#ff6b7a]/70"></span>
      </div>
      <div class="space-y-1 p-4">
        <p><span class="text-accent">florian@portfolio:~$</span> cd ./cette-page</p>
        <p class="text-[#ff6b7a]">bash: cd: ./cette-page: No such file or directory</p>
        <p class="pt-3 text-muted"># Commandes suggérées / suggested commands :</p>
        <ul>
          {
            suggestions.map((s) => (
              <li>
                <a href={s.href} class="group flex min-h-11 items-center gap-3 hover:text-accent">
                  <span class="text-accent">$</span>
                  <span class="underline decoration-line underline-offset-4 group-hover:decoration-accent">{s.cmd}</span>
                  <span class="text-muted"># {s.desc}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="mt-8 hidden items-center gap-2 font-mono text-xs text-muted md:flex">
      <kbd>²</kbd> ou <kbd>/</kbd> pour ouvrir le vrai terminal
    </p>
  </section>
</Base>
